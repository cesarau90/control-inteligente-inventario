# Copia este archivo como .env. Sin estos datos se activa el modo de demostración.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_TO=
SMTP_USE_TLS=true

# Intervalo del proceso monitor (segundos; mínimo 10).
CHECK_INTERVAL_SECONDS=60
# Opcional. Si se omite, se usa inventario.db en la carpeta del proyecto.
DATABASE_PATH=
